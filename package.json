    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "date-fns": "^4.1.0",
    "expo": "~56.0.0-preview.7",
    "expo-constants": "~56.0.6",
    "expo-document-picker": "~56.0.3",
    "expo-file-system": "~56.0.4",
    "expo-font": "~56.0.3",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.4",
    "expo-linking": "~56.0.4",
    "expo-localization": "~56.0.3",
    "expo-notifications": "~56.0.5",
    "expo-router": "~56.1.1",
    "expo-sharing": "~56.0.5",
    "expo-splash-screen": "~56.0.4",
    "expo-sqlite": "~56.0.3",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-system-ui": "~56.0.4",
    "expo-web-browser": "~56.0.4",
    "i18n-js": "^4.5.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.9",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.24.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "eas-cli": "^18.11.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.0",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|expo-modules-core|@react-native/.*))"
    ]
  },
  "private": true
}
